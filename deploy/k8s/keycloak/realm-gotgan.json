{
  "realm": "gotgan",
  "displayName": "곳간 GOTGAN",
  "enabled": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 1209600,
  "ssoSessionMaxLifespan": 1209600,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(8) and regexPattern(.*[A-Za-z].*) and specialChars(1) and notUsername",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "roles": {
    "realm": [
      {
        "name": "BUYER",
        "description": "구매자 — 가입 시 기본"
      },
      {
        "name": "SELLER",
        "description": "판매자 — 입점 승인 시 추가 (StoreApproved)"
      },
      {
        "name": "ADMIN",
        "description": "스토어 관리자 — 시드 계정으로만"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-gotgan",
        "description": "새 사용자 기본 역할 — BUYER 포함",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "BUYER"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-gotgan",
    "composite": true
  },
  "clients": [
    {
      "clientId": "gotgan-backend",
      "name": "gotgan backend (user-service 대리 호출)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${GOTGAN_BACKEND_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "https://gotgan-ashy.vercel.app/api/auth/social/callback",
        "https://api.gotgan.click/api/auth/social/callback",
        "http://localhost:8081/api/auth/social/callback",
        "http://localhost:18080/api/auth/social/callback",
        "http://localhost:5173/api/auth/social/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "user_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "user_id",
            "claim.name": "user_id",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "store_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "store_id",
            "claim.name": "store_id",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "hideOnLogin": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID:unset}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET:unset}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "kakao",
      "displayName": "카카오",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "hideOnLogin": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${KAKAO_CLIENT_ID:unset}",
        "clientSecret": "${KAKAO_CLIENT_SECRET:unset}",
        "clientAuthMethod": "client_secret_post",
        "authorizationUrl": "https://kauth.kakao.com/oauth/authorize",
        "tokenUrl": "https://kauth.kakao.com/oauth/token",
        "userInfoUrl": "https://kapi.kakao.com/v1/oidc/userinfo",
        "issuer": "https://kauth.kakao.com",
        "jwksUrl": "https://kauth.kakao.com/.well-known/jwks.json",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultScope": "openid account_email profile_nickname",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "naver",
      "displayName": "네이버",
      "providerId": "oauth2",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "hideOnLogin": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${NAVER_CLIENT_ID:unset}",
        "clientSecret": "${NAVER_CLIENT_SECRET:unset}",
        "clientAuthMethod": "client_secret_post",
        "authorizationUrl": "https://nid.naver.com/oauth2.0/authorize",
        "tokenUrl": "https://nid.naver.com/oauth2.0/token",
        "userInfoUrl": "https://openapi.naver.com/v1/nid/me",
        "userIDClaim": "response.id",
        "userNameClaim": "response.email",
        "emailClaim": "response.email",
        "fullNameClaim": "response.name",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "kakao-nickname",
      "identityProviderAlias": "kakao",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "IMPORT",
        "claim": "nickname",
        "user.attribute": "firstName"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-gotgan-backend",
      "enabled": true,
      "serviceAccountClientId": "gotgan-backend",
      "realmRoles": [
        "default-roles-gotgan"
      ],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-realm"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"user_id\", \"displayName\": \"userdb user_id\", \"validations\": {\"integer\": {\"min\": 1}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"store_id\", \"displayName\": \"store-service store_id (판매자만)\", \"validations\": {\"integer\": {\"min\": 1}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
