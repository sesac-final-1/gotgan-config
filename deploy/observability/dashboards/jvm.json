          "expr": "max(sum by (pod) (container_memory_working_set_bytes{namespace=\"sesac-gojigi\", container=~\"$app\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"sesac-gojigi\", container=~\"$app\", resource=\"memory\"}))",
          "legendFormat": "",
