          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(jvm_memory_used_bytes{namespace=\"sesac-gojigi\"}, app)",
          "refId": "app"
        },
        "definition": "label_values(jvm_memory_used_bytes{namespace=\"sesac-gojigi\"}, app)",
        "description": "JVM 지표를 내는 서비스만 목록에 나옵니다. All은 업무 서비스 전체이며 MySQL · Redis · Keycloak은 빠집니다.",
        "refresh": 2,
